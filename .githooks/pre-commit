#!/usr/bin/env bash
# Checks the Python and shell entry points before the commit exists. This repo has no formatter or linter yet.
# A commit is also refused with --no-verify by the dotagent hook.
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "==> syntax"
python3 -m py_compile plugin/hooks/guard.py
sh -n plugin/hooks/run.sh
sh -n plugin/hooks/loop.sh
bash -n .githooks/pre-commit .githooks/commit-msg .githooks/pre-push
