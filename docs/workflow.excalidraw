   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One branch for the whole TODO, one commit per subtask. It\nnever pushes, opens a PR, or runs CI. At the end it squashes\nlocally, or leaves the branch to you.",
   "originalText": "One branch for the whole TODO, one commit per subtask. It never pushes, opens a PR, or runs CI. At the end it squashes locally, or leaves the branch to you.",
