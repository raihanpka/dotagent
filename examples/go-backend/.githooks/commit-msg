#!/usr/bin/env bash
# Validates the commit message: type(scope): summary, one line. Same rule the agent hook enforces.
msg="$(head -n 1 "$1")"
if echo "$msg" | grep -qE '^Merge |^fixup! |^squash! '; then
  exit 0
fi
types="feat|fix|hotfix|docs|style|refactor|test|chore|perf|revert|ci|build"
if ! echo "$msg" | grep -Eq "^($types)\([a-zA-Z0-9_.-]+\): .+"; then
  echo "Invalid commit message. Expected: type(scope): summary"
  echo "Allowed types: $types"
  echo "Your message: $msg"
  exit 1
fi
if echo "$msg" | grep -Eiq '(^|[^a-z])(milestone|task|slice|step|phase|sprint)[-_ #]*[0-9]+|(finish(ed|ing)?|complete[d]?|done with) +(the +)?(task|slice|step|phase|milestone)([^a-z]|$)|\((milestone|task|todo|wip)\)|(^|[^a-z])wip([^a-z]|$)'; then
  echo "A commit message says what changed, not where it sits in the plan."
  echo "No milestone-1, task-2, slice 3, step 4, wip, or 'finishing task'. Your message: $msg"
  exit 1
fi
if echo "$msg" | grep -Eq '\(#[0-9]+\)' && ! echo "$msg" | grep -Eiq '^revert'; then
  echo "No (#N) in a commit message, GitHub adds the PR number when it merges. Your message: $msg"
  exit 1
fi
if grep -Eiq '^(co-authored-by|signed-off-by):|generated with|generated by (claude|ai|copilot|chatgpt|codex)|claude\.com/claude-code' "$1"; then
  echo "A commit message carries no trailer: no Co-Authored-By, Signed-off-by, or generated-by line."
  exit 1
fi
if [ "$(grep -cv '^#' "$1")" -gt 1 ]; then
  echo "A commit message is one line. Put the detail in the pull request."
  exit 1
fi
