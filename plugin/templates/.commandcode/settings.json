{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.dotagent/run.sh\" --client commandcode"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "shell|write|edit|shell_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.dotagent/run.sh\" --client commandcode"
          }
        ]
      }
    ]
  }
}
