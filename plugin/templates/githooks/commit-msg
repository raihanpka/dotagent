#!/usr/bin/env bash
# Validates the commit message: type(scope): summary, one line. Same rule the agent hook enforces.
msg="$(head -n 1 "$1")"
if echo "$msg" | grep -qE '^Merge |^fixup! |^squash! '; then
  exit 0
fi
types="feat|fix|hotfix|docs|style|refactor|test|chore|perf|revert|ci|build"
if ! echo "$msg" | grep -Eq "^($types)\([a-zA-Z0-9_.-]+\): .+"; then
  echo "Invalid commit message. Expected: type(scope): summary"
  echo "Allowed types: $types"
  echo "Your message: $msg"
  exit 1
fi
if [ "$(grep -cv '^#' "$1")" -gt 1 ]; then
  echo "A commit message is one line. Put the detail in the pull request."
  exit 1
fi
